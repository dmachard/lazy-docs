FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "kev[serve] @ git+https://github.com/jaredpalmer/kev.git"

ENV KEV_MODEL=jaredpalmer/kev-0.8b
ENV PORT=8009

EXPOSE 8009

CMD ["sh", "-c", "python -m kev.serve --run ${KEV_MODEL} --host 0.0.0.0 --port ${PORT}"]
